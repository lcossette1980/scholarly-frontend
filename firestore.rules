// Firestore Security Rules for DraftEngine (scholarlyai-33fca)
// Deploy: firebase deploy --only firestore:rules
//
// P0 2026-11-23: rules are OR'd, so a broad `allow read, write: if isOwner`
// let any signed-in user write ANY field of their own user doc (is_admin,
// subscription.plan, usage counters). Clients may now write only profile and
// onboarding fields. Everything the backend trusts (subscription*, is_admin,
// outlineUsage, usage/credit counters, Stripe ids) is server-only (Admin SDK).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Matches backend ADMIN_EMAILS (main.py). Used only for reading support messages.
    function isAdminEmail() {
      return signedIn()
        && request.auth.token.email in ['loren.cossette@gmail.com']
        && request.auth.token.email_verified == true;
    }

    // Fields a client may write on its own user doc after creation.
    function clientUpdatableUserKeys() {
      return ['displayName', 'photoURL', 'preferences', 'updatedAt',
              'onboardingRole', 'onboardingPurpose', 'onboardingPurposes',
              'onboardingCompleted'];
    }

    // The exact trial subscription createUserDocument() writes (src/services/auth.js).
    function isTrialDefault(s) {
      return s is map
        && s.keys().hasOnly(['plan', 'status', 'entriesUsed', 'entriesLimit',
                             'entriesRemaining', 'isLifetime', 'periodEnd'])
        && s.plan == 'trial'
        && s.status == 'active'
        && s.entriesUsed == 0
        && s.entriesLimit == 5
        && s.entriesRemaining == 5
        && s.isLifetime == true
        && s.periodEnd == null;
    }

    // ---- users/{uid} ------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId);

      // First sign-in: profile fields + the trial default only.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'photoURL', 'createdAt', 'subscription',
              'preferences', 'updatedAt', 'onboardingRole', 'onboardingPurpose',
              'onboardingPurposes', 'onboardingCompleted'])
        && (!('subscription' in request.resource.data)
            || isTrialDefault(request.resource.data.subscription))
        && (!('email' in request.resource.data)
            || request.resource.data.email == request.auth.token.email);

      // Profile + onboarding only. subscription*, is_admin, outlineUsage,
      // usage counters and Stripe ids are written by the backend.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(clientUpdatableUserKeys());

      // No client delete: account deletion runs on the backend
      // (DELETE /api/account), which removes the Firebase Auth user first.
      // A client delete + re-create used to reset the free limits.
      allow delete: if false;
    }

    // ---- bibliography_entries (sources) ----------------------------------
    match /bibliography_entries/{entryId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    // Legacy collection name (kept as before).
    match /bibliography/{entryId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    // ---- content_generation_jobs: read/delete own; backend writes --------
    match /content_generation_jobs/{jobId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if false;
    }

    // ---- support_messages: users send, the admin reads -------------------
    match /support_messages/{messageId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['userId', 'userEmail', 'userName', 'subject', 'message',
              'category', 'read', 'priority', 'createdAt'])
        && request.resource.data.read == false;
      allow read: if isAdminEmail();
      allow update, delete: if false;
    }

    // ---- logs (create own; never read from the client) -------------------
    match /usage_logs/{logId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }
    match /error_logs/{logId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ---- server-only ------------------------------------------------------
    match /admin/{document=**} {
      allow read, write: if false;
    }
    match /config/{document} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /stripe_logs/{logId} {
      allow read, write: if false;
    }

    // Everything else (monthly_page_reservations, stripe_webhook_events,
    // feed collections, …) is backend-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
